# Copy to .env and fill in. .env is git-ignored – never commit real credentials.

# Test accounts
IG_VALID_USERNAME=your_test_account
IG_VALID_PASSWORD=your_test_password
IG_INVALID_USERNAME=not_a_real_user_123
IG_INVALID_PASSWORD=wrong_password

# Device (optional – defaults to emulator-5554)
DEVICE_NAME=emulator-5554
# UDID=emulator-5554
# PLATFORM_VERSION=13

# Run options (optional)
# LOG_LEVEL=warn            # trace | debug | info | warn | error
# RETRIES=0                 # re-run a failed spec file N times
# KEEP_RUNS=30              # how many runs the dashboard keeps
# RUN_LABEL=build 1.4.2     # free text shown on the dashboard for this run
# DENY_ALL_PERMISSIONS=false
